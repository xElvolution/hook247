# Copy to .env and fill in. Never commit the filled-in .env.

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Neon dashboard → Connect → Connection string. Use the POOLED host ("-pooler").
# If `npm run db:push` is rejected by the pooler, push once with the unpooled
# host (drop "-pooler"), then switch back.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─── Sessions ────────────────────────────────────────────────────────────────
# Any long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=""

# Instant demo login (skips the database). On in development by default.
# Set to 0 to disable. Do not enable in production.
ALLOW_MOCK_LOGIN="1"
NEXT_PUBLIC_ALLOW_MOCK_LOGIN="1"

# ─── Admin Console ───────────────────────────────────────────────────────────
# Console is at <NEXT_PUBLIC_APP_URL>/502test — sign in at /502test/enter.
# Generate ADMIN_PASSWORD with `openssl rand -base64 24`
ADMIN_PASSWORD=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Used for Paystack callbacks and email links. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── Email (Hostinger SMTP) ──────────────────────────────────────────────────
# 465 = implicit TLS, 587 = STARTTLS
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT="465"
EMAIL_USER="noreply@yourdomain.com"
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@yourdomain.com"

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
# Register this webhook in the Paystack dashboard:
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/paystack
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# ─── ID Verification (Dojah — NIN + selfie liveness) ─────────────────────────
# From app.dojah.io → your app → API Keys / Widgets. Register this webhook in
# the Dojah dashboard: <NEXT_PUBLIC_APP_URL>/api/webhooks/dojah
# The secret key is server-only; never expose it. Leave blank to disable the
# verification feature (the "Get verified" button shows as unavailable).
DOJAH_APP_ID=""
DOJAH_PUBLIC_KEY=""
DOJAH_SECRET_KEY=""
DOJAH_WIDGET_ID=""
