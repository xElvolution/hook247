generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  NONBINARY
}

enum Plan {
  FREE
  PLUS
  ELITE
}

enum AccountRole {
  ESCORT
  CLIENT
}

enum VerificationType {
  SIGNUP
  RESET
}

enum PaymentPurpose {
  PLAN_PLUS
  PLAN_ELITE
  BOOST
  VERIFICATION
  SUBSCRIPTION
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  PAID
  VOID
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum ReportReason {
  SPAM
  HARASSMENT
  NUDITY
  UNDERAGE
  NON_CONSENSUAL
  SCAM
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTarget {
  USER
  POST
  COMMENT
}

/// Why a profile carries the verified badge. PAID is the legacy path where
/// paying set the badge outright; REVIEWED means a human approved it; DOJAH
/// means a real NIN + selfie-liveness KYC check passed via the Dojah widget.
enum VerificationSource {
  NONE
  PAID
  REVIEWED
  DOJAH
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  /// Set when an admin bans the account. Non-null means the user cannot log in
  /// and any existing session is rejected at the authed layout.
  bannedAt       DateTime?
  banReason      String    @default("")
  /// Temporary suspension. Unlike a ban this lapses on its own.
  suspendedUntil DateTime?
  /// When the member confirmed they are 18+ to open the Erotica board.
  adultConfirmedAt DateTime?

  /// Shareable code for /signup?ref=CODE. Generated at signup.
  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")
  referralEarnings ReferralEarning[]
  withdrawals        Withdrawal[]

  profile            Profile?
  swipesGiven        Swipe[]             @relation("swiper")
  swipesGotten       Swipe[]             @relation("swiped")
  matchesA           Match[]             @relation("userA")
  matchesB           Match[]             @relation("userB")
  messages           Message[]
  posts              Post[]
  postLikes          PostLike[]
  comments           Comment[]
  emailVerifications EmailVerification[]
  payments           Payment[]
  reportsMade        Report[]            @relation("reporter")
  reportsAgainst     Report[]            @relation("reportedUser")
  reviewsWritten     ListingReview[]     @relation("reviewAuthor")
  pollVotes          PollVote[]
  coinWallet         CoinWallet?
  coinTransactions   CoinTransaction[]
  coinPurchases      CoinPurchase[]
  coinWithdrawals    CoinWithdrawal[]
  liveSessions       LiveSession[]
  liveComments       LiveComment[]
  loungeMessages     LoungeMessage[]
  payoutAccount      PayoutAccount?
  earningsWallet     EarningsWallet?
  earningsTransactions EarningsTransaction[]
  withdrawalAccounts WithdrawalAccount[]
  following          Follow[]            @relation("follower")
  followers          Follow[]            @relation("following")

  /// Admin switch: the account can neither send nor receive gifts and tips.
  giftingDisabled Boolean @default(false)
  /// Admin switch: withdrawals are refused and pending ones cannot be approved.
  payoutsFrozen   Boolean @default(false)

  @@index([bannedAt])
  @@index([createdAt])
  @@index([referredById])
}

model Profile {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  birthDate      DateTime
  gender         Gender
  lookingFor     Gender[]
  bio            String             @default("")
  country        String             @default("Nigeria")
  state          String             @default("")
  city           String             @default("")
  ethnicity      String             @default("")
  bodyBuild      String             @default("")
  bustSize       String             @default("")
  thighs         String             @default("")
  education      String             @default("")
  smoking        String             @default("")
  orientation    String             @default("")
  interests      String[]           @default([])
  avatarUrl      String             @default("")
  photos         String[]           @default([])
  clips          String[]           @default([])
  role           AccountRole        @default(ESCORT)
  /// Public WhatsApp number for listing-board contact (digits with country code).
  whatsapp       String             @default("")
  verified       Boolean            @default(false)
  /// How the badge was granted, so the review queue can tell an unreviewed
  /// paid badge from one a human actually approved.
  verifiedSource VerificationSource @default(NONE)
  verifiedAt     DateTime?
  verifyNote     String             @default("")
  availableToday Boolean            @default(false)
  isLive         Boolean            @default(false)
  profileViews   Int                @default(0)
  plan           Plan               @default(FREE)
  subscriptionExpiresAt DateTime?
  subscriptionPlanSlug  String      @default("")
  boostedAt      DateTime?
  boostedUntil   DateTime?
  /// When true, the profile is taken off public browse even if a plan is active.
  adminHidden    Boolean            @default(false)
  lastActive     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  services       ServiceOffer[]

  @@index([verifiedSource])
  @@index([role, city])
  @@index([state, city])
}

model ServiceOffer {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  incallRate  Int?
  outcallRate Int?
  enabled     Boolean @default(true)

  @@unique([profileId, name])
  @@index([name, enabled])
}

model Swipe {
  id        String   @id @default(cuid())
  swiperId  String
  swipedId  String
  liked     Boolean
  createdAt DateTime @default(now())

  swiper User @relation("swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped User @relation("swiped", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swipedId, liked])
}

/// ACCEPTED conversations show in both inboxes. A PENDING one is a message
/// request from `requestedById` to someone who does not follow them: it waits
/// in the recipient's Requests tab until they accept or decline it.
enum MatchStatus {
  ACCEPTED
  PENDING
  DECLINED
}

model Match {
  id            String      @id @default(cuid())
  userAId       String
  userBId       String
  createdAt     DateTime    @default(now())
  status        MatchStatus @default(ACCEPTED)
  requestedById String?
  respondedAt   DateTime?

  userA    User      @relation("userA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("userB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
}

/// One member following another. `seenAt` stays null until the person being
/// followed opens their followers list, which drives the new follower badge.
model Follow {
  id          String    @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime  @default(now())
  seenAt      DateTime?

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  /// When the recipient opened the conversation after this message arrived.
  readAt    DateTime?

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model Post {
  id         String    @id @default(cuid())
  authorId   String
  body       String
  imageUrl   String    @default("")
  videoUrl   String    @default("")
  category   String    @default("explore")
  createdAt  DateTime  @default(now())
  /// Set by an admin takedown. Hidden posts stay in the table for the audit
  /// trail but are filtered out of the feed.
  hiddenAt   DateTime?
  hideReason String    @default("")
  /// Erotica posts only: when the author attested they own the content and
  /// everyone shown is 18+ and consented.
  adultAttestedAt DateTime?

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments Comment[]
  poll     Poll?

  @@index([createdAt])
  @@index([hiddenAt])
  @@index([category, createdAt])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  hiddenAt  DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Six-digit codes for signup confirmation and password reset. Rows are kept
/// after use so a code can never be replayed; cleanup is by expiresAt.
model EmailVerification {
  id        String           @id @default(cuid())
  userId    String
  email     String
  code      String
  type      VerificationType @default(SIGNUP)
  verified  Boolean          @default(false)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, code, type])
  @@index([expiresAt])
}

/// One row per Paystack checkout. `reference` is what we send to Paystack and
/// what the webhook echoes back, so it is the idempotency key for fulfilment.
model Payment {
  id          String         @id @default(cuid())
  userId      String
  reference   String         @unique
  purpose     PaymentPurpose
  productId   String         @default("")
  amountKobo  Int
  status      PaymentStatus  @default(PENDING)
  fulfilledAt DateTime?
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// A user-submitted report. `targetType` says which of the target columns is
/// meaningful; the others stay null.
model Report {
  id              String       @id @default(cuid())
  reporterId      String
  targetType      ReportTarget
  targetUserId    String?
  targetPostId    String?
  targetCommentId String?
  reason          ReportReason
  details         String       @default("")
  status          ReportStatus @default(OPEN)
  resolution      String       @default("")
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  reporter     User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("reportedUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  // One open report per reporter per target: re-reporting the same profile
  // shouldn't flood the queue, but a resolved report can be followed by a new one.
  @@index([status, createdAt])
  @@index([targetUserId])
}

/// Append-only audit log of everything done from the admin console. Nothing
/// here is ever updated or deleted — it is the record of who did what.
model AdminAction {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// One-level commission: A earns from B's qualifying subscription payments only.
model ReferralEarning {
  id              String            @id @default(cuid())
  referrerId      String
  referredId      String
  paymentId       String            @unique
  sourceKobo      Int
  amountKobo      Int
  percent         Int
  paymentNumber   Int
  planName        String            @default("")
  transactionRef  String            @default("")
  status          CommissionStatus  @default(PENDING)
  availableAt     DateTime
  voidReason      String            @default("")
  createdAt       DateTime          @default(now())

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, status, createdAt])
  @@index([referredId, createdAt])
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amountKobo    Int
  status        WithdrawalStatus @default(REQUESTED)
  accountName   String
  accountNumber String
  bankName      String
  adminNote     String           @default("")
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  durationDays   Int
  priceKobo      Int
  active         Boolean  @default(true)
  publicVisible  Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model BoostProduct {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  durationHours  Int
  priceKobo      Int
  active         Boolean  @default(true)
  publicVisible  Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model PlatformSettings {
  id                   String   @id @default("default")
  commissionPct1       Int      @default(2)
  commissionPct2       Int      @default(2)
  commissionPct3       Int      @default(2)
  qualifyingPayments   Int      @default(3)
  minWithdrawalKobo    Int      @default(500000)
  holdHours            Int      @default(72)
  updatedAt            DateTime @updatedAt
}

model ListingReview {
  id            String   @id @default(cuid())
  listingUserId String
  authorId      String
  rating        Int
  body          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author User @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([listingUserId, authorId])
  @@index([listingUserId, createdAt])
}

/// A WhatsApp-style poll attached to a post. The post body carries any extra
/// caption; the question and its options live here.
model Poll {
  id            String   @id @default(cuid())
  postId        String   @unique
  question      String
  allowMultiple Boolean  @default(false)
  createdAt     DateTime @default(now())

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  label    String
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, position])
}

/// One row per chosen option. Single-answer polls hold at most one row per
/// voter; changing a vote replaces the voter's rows inside a transaction.
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

enum CoinTxType {
  PURCHASE
  TIP_SENT
  TIP_RECEIVED
  WITHDRAWAL_REQUEST
  WITHDRAWAL_PAID
  WITHDRAWAL_REFUND
  ADMIN_ADJUST
  GIFT_SENT
  LEGACY_CONVERSION
}

/// Cached coin balance. `balance` is spendable; `held` is coins locked in a
/// withdrawal request that has not been paid or rejected yet. Both are only
/// ever changed together with a CoinTransaction row, inside one transaction.
model CoinWallet {
  userId         String   @id
  balance        Int      @default(0)
  held           Int      @default(0)
  lifetimeEarned Int      @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Append-only coin ledger. Rows are never updated or deleted (a database
/// trigger enforces this). `amount` is the signed change to the spendable
/// balance and `balanceAfter` the balance once it was applied.
model CoinTransaction {
  id             String     @id @default(cuid())
  userId         String
  type           CoinTxType
  amount         Int
  balanceAfter   Int
  /// Unique key that makes retries safe (Paystack reference, tip nonce...).
  idempotencyKey String?    @unique
  counterpartyId String?
  postId         String?
  liveSessionId  String?
  giftId         String?
  purchaseId     String?
  withdrawalId   String?
  source         String     @default("")
  note           String     @default("")
  createdAt      DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([liveSessionId])
}

/// A coin package. `priceKobo` is always coins x the fixed coin price; the
/// checkout recomputes it rather than trusting the stored figure.
model CoinPack {
  id        String   @id @default(cuid())
  name      String
  coins     Int
  priceKobo Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// One row per coin checkout. `reference` is what Paystack echoes back, so it
/// is the idempotency key for crediting coins.
model CoinPurchase {
  id         String        @id @default(cuid())
  userId     String
  packId     String
  coins      Int
  amountKobo Int
  reference  String        @unique
  status     PaymentStatus @default(PENDING)
  creditedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CoinSettings {
  id                       String   @id @default("default")
  /// Legacy (v1): what one coin paid out to an escort, in kobo. Kept because
  /// escort coin balances were converted to naira earnings at this rate.
  payoutKoboPerCoin        Int      @default(750)
  /// Legacy (v1) minimum withdrawal in coins. Unused since earnings are naira.
  minWithdrawalCoins       Int      @default(1000)
  /// Only switch on once Paystack Transfers are enabled on the account.
  paystackTransfersEnabled Boolean  @default(false)
  /// What one coin costs the buyer, in kobo. Fixed at N50.
  coinPriceKobo            Int      @default(5000)
  /// Escort share of every gift, in percent. The platform keeps the rest.
  escortSharePct           Int      @default(70)
  /// Withdrawal fee in basis points (200 = 2%).
  withdrawalFeeBps         Int      @default(200)
  /// When on, every withdrawal waits for an admin to approve it.
  manualWithdrawalApproval Boolean  @default(true)
  /// Set once escort coin balances were converted to naira earnings.
  legacyConvertedAt        DateTime?
  updatedAt                DateTime @updatedAt
}

/// A cash out request. v2 requests draw on the naira earnings wallet
/// (`source` = "earnings"): `grossKobo` leaves the wallet, `feeKobo` is the
/// withdrawal fee and `amountKobo` is what is sent to the bank. Legacy v1
/// requests (`source` = "coins") held coins and paid `amountKobo`.
model CoinWithdrawal {
  id              String           @id @default(cuid())
  userId          String
  coins           Int
  /// Payout sent to the bank account, in kobo.
  amountKobo      Int
  source          String           @default("coins")
  grossKobo       Int              @default(0)
  feeKobo         Int              @default(0)
  feeBps          Int              @default(0)
  accountId       String?
  approvedAt      DateTime?
  status          WithdrawalStatus @default(REQUESTED)
  bankCode        String
  bankName        String
  accountNumber   String
  accountName     String
  payoutReference String           @default("")
  transferCode    String           @default("")
  adminNote       String           @default("")
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model PayoutAccount {
  userId        String   @id
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String   @default("")
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- live video

enum LiveStatus {
  LIVE
  ENDED
}

/// One broadcast by an escort. Media runs through the self-hosted LiveKit server.
model LiveSession {
  id          String     @id @default(cuid())
  hostId      String
  title       String
  roomName    String     @unique
  status      LiveStatus @default(LIVE)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  /// Last time the host was seen connected to the room.
  hostSeenAt  DateTime   @default(now())
  peakViewers Int        @default(0)
  endReason   String     @default("")

  host     User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  comments LiveComment[]

  @@index([status, startedAt])
  @@index([hostId, startedAt])
}

model LiveComment {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// Gifts viewers can send during a live. Priced in coins; editable in the console.
model LiveGift {
  id        String   @id @default(cuid())
  name      String
  emoji     String
  coins     Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  /// Overlay effect: float, pulse, burst, spotlight or royal.
  animation String   @default("float")
  /// Soft delete for gifts that already appear in the ledger.
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- lounge

/// Public group chat for signed-in members.
model LoungeMessage {
  id        String    @id @default(cuid())
  userId    String
  body      String
  createdAt DateTime  @default(now())
  hiddenAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ---------------------------------------------------------------- earnings (v2)

/// An escort's naira earnings from gifts. `balanceKobo` is withdrawable,
/// `heldKobo` is locked in a pending withdrawal. Only ever changed together
/// with an EarningsTransaction row, inside one database transaction.
model EarningsWallet {
  userId       String   @id
  balanceKobo  Int      @default(0)
  heldKobo     Int      @default(0)
  lifetimeKobo Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

enum EarningsTxType {
  GIFT_SHARE
  LEGACY_CONVERSION
  WITHDRAWAL_HOLD
  WITHDRAWAL_PAID
  WITHDRAWAL_RELEASE
  ADMIN_ADJUST
}

/// Append-only naira ledger for escort earnings (a trigger refuses updates).
model EarningsTransaction {
  id               String         @id @default(cuid())
  userId           String
  type             EarningsTxType
  /// Signed change to the withdrawable balance, in kobo.
  amountKobo       Int
  /// Signed change to the held balance, in kobo.
  heldKobo         Int            @default(0)
  balanceAfterKobo Int
  idempotencyKey   String         @unique
  ledgerEntryId    String?
  withdrawalId     String?
  note             String         @default("")
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum LedgerKind {
  GIFT
  PURCHASE
  WITHDRAWAL_REQUEST
  WITHDRAWAL_APPROVED
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  LEGACY_CONVERSION
  ADMIN_ADJUST
}

enum LedgerStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

/// Platform transaction ledger: one row per money event (gift, purchase,
/// withdrawal step). Gift rows carry the full split. Append-only.
model LedgerEntry {
  id                String       @id @default(cuid())
  kind              LedgerKind
  status            LedgerStatus @default(COMPLETED)
  idempotencyKey    String       @unique
  senderId          String?
  receiverId        String?
  giftId            String?
  giftName          String       @default("")
  giftEmoji         String       @default("")
  coins             Int          @default(0)
  coinPriceKobo     Int          @default(0)
  /// Gross value in kobo (gift value, purchase amount, withdrawal amount).
  amountKobo        Int          @default(0)
  escortSharePct    Int          @default(0)
  escortShareKobo   Int          @default(0)
  platformShareKobo Int          @default(0)
  feeKobo           Int          @default(0)
  payoutKobo        Int          @default(0)
  liveSessionId     String?
  postId            String?
  purchaseId        String?
  withdrawalId      String?
  source            String       @default("")
  note              String       @default("")
  createdAt         DateTime     @default(now())

  @@index([kind, createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([liveSessionId])
  @@index([withdrawalId])
}

/// Saved bank accounts an escort can withdraw to.
model WithdrawalAccount {
  id            String   @id @default(cuid())
  userId        String
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String   @default("")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankCode, accountNumber])
  @@index([userId])
}
